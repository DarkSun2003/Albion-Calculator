# ==========================================
# Albion Artisan Forgemaster - Backend .env
# ==========================================

# 1. Django Security Settings
DJANGO_DEBUG=True
SECRET_KEY=django-insecure-local-dev-key-change-in-production

# 2. Database Connection
# Leave blank or commented out for local development (defaults to local SQLite3: db.sqlite3).
# In Railway production, Railway injects this automatically when you add PostgreSQL:
# DATABASE_URL=postgresql://postgres:password@roundhouse.proxy.rlwy.net:12345/railway
DATABASE_URL=

# 3. Allowed Hosts & CORS
# In production on Railway, set your frontend Vercel domain:
ALLOWED_HOSTS=*
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://*.vercel.app
